  IGADDOUTP = 0,
  IGSOURCE = 2,
  IGBCOVERWRITE = .TRUE.,
  IGMAXFREQ = 0.03,
  IGSTERMS = 0,
  IGSWELLMAX = .TRUE.,
  IGSOURCEATBP = 0,
  IGKDMIN = 1.1,
  IGFIXEDDEPTH = 0.0,
  IGEMPIRICAL = 0.00125
/
! -------------------------------------------------------------------- !
!   Cavaleri and M-R    : Namelist SLN1
! -------------------------------------------------------------------- !
&SLN1
