  ALPHA0 = 0.0095,
  Z0MAX = 0.0,
  BETAMAX = 1.43,
  SINTHP = 2.0,
  ZALP = 0.006,
  TAUWSHELTER = 0.3,
  SWELLFPAR = 1,
  SWELLF = 0.66,
  SWELLF2 = -0.018,
  SWELLF3 = 0.022,
  SWELLF4 = 1.5E5,
  SWELLF5 = 1.2,
  SWELLF6 = 0.0,
  SWELLF7 = 360000.0,
  Z0RAT = 0.04,
  SINBR = 0.0
/
