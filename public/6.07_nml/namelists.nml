! -------------------------------------------------------------------- !
! WAVEWATCH III 6.07 - namelists.nml (model parameters)              !
! -------------------------------------------------------------------- !
! Adapted from WW3 v6.07.1 source code (ww3_grid.ftn NAMELIST defs)  !
! -------------------------------------------------------------------- !

! -------------------------------------------------------------------- !
! MISC namelist - Miscellaneous parameters                            !
! -------------------------------------------------------------------- !
! FLAGTR : Transparency flag for obstruction subgrid                  !
!          0 = No obstruction subgrid                                 !
!          1 = Transparencies at cell boundaries                      !
!          2 = Transparencies at cell centers                         !
!          3 = Transparencies at cell boundaries with continuous ice  !
!          4 = Transparencies at cell centers with continuous ice     !
! RWNDC  : Wind speed cutoff (m/s), below which wind input is zero    !
! NOLEAP : If TRUE, use 365-day (no-leap) calendar                   !
! -------------------------------------------------------------------- !
&MISC
  CICE0 = 0.5,
  CICEN = 0.5,
  LICE = 0.0,
  XSEED = 1.0,
  FLAGTR = 0,
  XP = 0.15,
  XR = 0.10,
  XFILT = 0.05,
  PMOVE = 0.5,
  IHM = 100,
  HSPM = 0.05,
  WSM = 1.7,
  WSC = 0.333,
  FLC = .TRUE.,
  FMICHE = 1.6,
  RWNDC = 1.0,
  FACBERG = 1.0,
  NOSW = 5,
  GSHIFT = 0.0,
  WCOR1 = 99.0,
  WCOR2 = 0.0,
  STDX = -1.0,
  STDY = -1.0,
  STDT = -1.0,
  ICEHMIN = 0.2,
  ICEHINIT = 0.5,
  ICEDISP = .FALSE.,
  ICESLN = 1.0,
  ICEWIND = 1.0,
  ICESNL = 1.0,
  ICESDS = 1.0,
  ICEHFAC = 1.0,
  ICEHDISP = 0.6,
  ICEDDISP = 80,
  ICEFDISP = 2,
  NOLEAP = .FALSE.,
  TRCKCMPR = .TRUE.,
  PTM = 1,
  PTFC = 0.1,
  BTBET = 1.2
/


!
! -------------------------------------------------------------------- !
! FLX3 namelist - Flux/Bottom friction parameters                     !
! -------------------------------------------------------------------- !
! CDMAX  : Maximum drag coefficient for bottom friction              !
! CTYPE  : Type flag for bottom friction parameterization             !
!          0 = Default scheme (most stable)                           !
!          1 = Empirical formula varying with wind speed               !
!          2 = High wind speed correction scheme                      !
!          3 = Advanced experimental scheme                           !
! -------------------------------------------------------------------- !
&FLX3
  CDMAX = 2.5E-3,
  CTYPE = 0
/




! Output of 3D arrays------------------------------------------------- !
! Parameters (integers)   : Namelist OUTS
! -------------------------------------------------------------------- !
&OUTS
  P2SF = 0,
  I1P2SF = 1,
  I2P2SF = 15,
  US3D = 0,
  I1US3D = 1,
  I2US3D = 32,
  USSP = 0,
  IUSSP = 1,
  STK_WN(1) = 0.0628318531,
  E3D = 0,
  I1E3D = 1,
  I2E3D = 32,
  TH1MF = 0,
  I1TH1M = 1,
  I2TH1M = 32,
  STH1MF = 0,
  I1STH1M = 1,
  I2STH1M = 32,
  TH2MF = 0,
  I1TH2M = 1,
  I2TH2M = 32,
  STH2MF = 0,
  I1STH2M = 1,
  I2STH2M = 32
/




!
! -------------------------------------------------------------------- !
! Explicit Default Namelists                                           !
! -------------------------------------------------------------------- !
!   Reichl et al. 2014  : Namelist FLD1
! -------------------------------------------------------------------- !
&FLD1
  TAILTYPE = 0,
  TAILLEV = 0.006,
  TAILT1 = 1.25,
  TAILT2 = 3.00
/
! -------------------------------------------------------------------- !
!   Donelan et al. 2012 : Namelist FLD2
! -------------------------------------------------------------------- !
&FLD2
  TAILTYPE = 0,
  TAILLEV = 0.006,
  TAILT1 = 1.25,
  TAILT2 = 3.00
/
! -------------------------------------------------------------------- !
!   Hwang 2011          : Namelist FLX4
! -------------------------------------------------------------------- !
&FLX4
  CDFAC = 1.0
/
! -------------------------------------------------------------------- !
!   Generalization of Liu et al. : Namelist SIC2
! -------------------------------------------------------------------- !
&SIC2
  IC2DISPER = .FALSE.,
  IC2TURB = 1.0,
  IC2ROUGH = 0.01,
  IC2REYNOLDS = 1.5E5,
  IC2SMOOTH = 2.0E5,
  IC2VISC = 1.0,
  IC2TURBS = 0.0,
  IC2DMAX = 0.0
/
! -------------------------------------------------------------------- !
!   Wang and Shen       : Namelist SIC3
! -------------------------------------------------------------------- !
&SIC3
  IC3MAXTHK = 100.0,
  IC2TURB = 2.0,
  IC2ROUGH = 0.02,
  IC2REYNOLDS = 1.5E5,
  IC2SMOOTH = 7.0E4,
  IC2VISC = 2.0,
  IC2TURBS = 0.0,
  IC3MAXCNC = 100.0,
  IC3CHENG = .TRUE.,
  USECGICE = .FALSE.,
  IC3HILIM = 100.0,
  IC3KILIM = 100.0,
  IC3VISC = -2.0,
  IC3ELAS = -4.0,
  IC3DENS = -3.0,
  IC3HICE = -1.0
/
! -------------------------------------------------------------------- !
!   Empirical/parametric representations : Namelist SIC4
!   NOTE: 6.07 only has IC4METHOD, IC4KI, IC4FC                      !
! -------------------------------------------------------------------- !
&SIC4
  IC4METHOD = 1,
  IC4KI = 0.0,
  IC4FC = 0.0
/
